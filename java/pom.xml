<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.manishpateluk</groupId>
  <artifactId>llm-router</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>LLM Router</name>
  <description>A Java library for routing LLM requests across multiple providers with automatic fallback, capability-aware adaptation, and cost optimization.</description>
  <url>https://github.com/manishpatelUK/llm-router</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/manishpatelUK/llm-router/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>manishpatelUK</id>
      <name>Manish Patel</name>
      <url>https://github.com/manishpatelUK</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/manishpatelUK/llm-router.git</connection>
    <developerConnection>scm:git:https://github.com/manishpatelUK/llm-router.git</developerConnection>
    <url>https://github.com/manishpatelUK/llm-router</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <lombok.version>1.18.38</lombok.version>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <anthropic.version>2.62.0</anthropic.version>
    <openai.version>4.63.1</openai.version>
    <slf4j.version>2.0.16</slf4j.version>
    <mockito.version>5.18.0</mockito.version>
    <!-- Single source of truth lives at the repo root, one level above this module;
         copied into target/classes at build time instead of being checked in here. -->
    <model-capability-table.dir>${project.basedir}/..</model-capability-table.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic.version}</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${openai.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Forces a JDK 25-aware Byte Buddy: assertj-core's own transitive 1.14.18 is
           otherwise nearer in the dependency tree and wins mediation over Mockito's. -->
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.17.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>25</source>
          <target>25</target>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Mockito's inline mock maker self-attaches as a Java agent at runtime; this
               keeps that working past the JDK's dynamic-agent-loading warning/future lockdown. -->
          <argLine>-XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
      <plugin>
        <!-- Copies model-capability-table.json from the repo root into target/classes
             ahead of every build, so the module never carries its own stale duplicate. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-model-capability-table</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${model-capability-table.dir}</directory>
                  <includes>
                    <include>model-capability-table.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Everything needed to publish to Maven Central, kept out of the default build so
           `mvn test`/`mvn package` stay fast and don't require a GPG key on every machine.
           Activate with `mvn clean deploy -Prelease` — see java/pom.xml's neighboring README
           for the one-time account/namespace/GPG setup this depends on. -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- doclint=none: the standard doclet otherwise hard-fails the build on things like
                 missing @param/@return tags, which this project doesn't maintain exhaustively
                 (especially on Lombok-generated accessors, which javadoc can't see or document
                 anyway since it parses source directly, before Lombok's annotation processing
                 runs). A broken {@link} reference would still be an error; keep {@link} pointed
                 only at hand-written methods/types, never at a Lombok-generated one (builder(),
                 toBuilder(), getters, etc.) — use {@code Foo.builder()} for those instead. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Central requires every published artifact to be PGP-signed. Relies on gpg-agent
                 (or an equivalent pinentry setup) to prompt for the passphrase interactively;
                 never put a signing passphrase in this file or in settings.xml in plaintext. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Uploads the signed bundle to the Central Publishing Portal. publishingServerId
                 must match a <server> entry in ~/.m2/settings.xml holding your Central user
                 token (Account -> Generate User Token on central.sonatype.com) — never commit
                 that token to this repo. autoPublish is deliberately left at its default
                 (false): the deployment lands in the Portal for you to review and publish
                 manually the first few times; flip it to true here once you're comfortable
                 fully automating releases. -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
